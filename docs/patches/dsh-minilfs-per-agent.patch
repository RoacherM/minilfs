+  it('gives every subagent its own branch on the shared plugin mount; only the lead applies', async () => {
+    // DSH mounts the plugin once and every subagent shares it (agent-preset-registry composeFrom):
+    // per-agent state must come from exec.agent, never from the mount.
+    const { tools, project, exec: lead } = await setup()
+    const child = (id) => ({
+      agent: { id, session: { header: { origin: 'subagent', parentSession: lead.agent.id, delegationDepth: 1 } } },
+      signal: new AbortController().signal,
+    })
+    const w1 = child(`w1-${Date.now()}`)
+    const w2 = child(`w2-${Date.now()}`)
+    const status = async e => (await tools.get('minilfs').execute({ action: 'status' }, e)).text
+    const branchOf = text => /branch: (\S+)/u.exec(text)?.[1]
+
+    const [sl, s1, s2] = await Promise.all([status(lead), status(w1), status(w2)])
+    assert.equal(new Set([branchOf(sl), branchOf(s1), branchOf(s2)]).size, 3, `three branches:\n${sl}\n${s1}\n${s2}`)
+    assert.match(s1, /alias: sub-/u)
+
+    await tools.get('write').execute({ file_path: join(project, 'w1.txt'), content: 'from w1\n' }, w1)
+    const seen = await tools.get('bash').execute({ command: 'cat w1.txt 2>/dev/null || echo absent' }, w2)
+    assert.equal(seen.output.trim(), 'absent', 'w2 does not see w1 uncommitted work')
+
+    const refused = await tools.get('minilfs_apply').execute({}, w1)
+    assert.match(refused.text, /^Refused: you are a subagent/u)
+    assert.equal(existsSync(join(project, 'w1.txt')), false)
+
+    const merged = await tools.get('minilfs').execute({ action: 'merge', branch: branchOf(s1) }, lead)
+    assert.match(merged.text, /Merged/iu, merged.text)
+    const applied = await tools.get('minilfs_apply').execute({}, lead)
+    assert.match(applied.text, /Applied 1 file\(s\)/u, applied.text)
+    assert.equal(await readFile(join(project, 'w1.txt'), 'utf8'), 'from w1\n')
+  })
+
