{
  "name": "@roacherm/minilfs",
  "version": "0.4.0",
  "description": "minilfs: 100% Native LayerFS workspace runtime + Claude Code srt-style macOS Seatbelt sandbox + pluggable distributed ExecutionDriver for Pi, Epi, Claude Code, Codex, and MCP.",
  "type": "module",
  "license": "MIT",
  "author": "RoacherM",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RoacherM/minilfs.git"
  },
  "homepage": "https://github.com/RoacherM/minilfs#readme",
  "bugs": "https://github.com/RoacherM/minilfs/issues",
  "keywords": [
    "minilfs",
    "pi-package",
    "pi-extension",
    "epi",
    "layerfs",
    "sandbox",
    "seatbelt",
    "mcp",
    "coding-agent"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "minilfs": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./driver": "./src/core/driver.ts",
    "./cli": "./src/cli.ts"
  },
  "files": [
    "src/",
    "scripts/setup-layerfs.sh",
    "scripts/setup-layerfs-native.sh",
    "docs/EPI-INTEGRATION.md",
    "docs/DESIGN-v0.2.md",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node tests/mode.test.mjs && node tests/native-seatbelt.test.mjs && node tests/backend.test.mjs && node tests/review-fixes.test.mjs && node tests/pi.test.mjs && node tests/cli.test.mjs && node tests/rpc.test.mjs && node tests/scale.test.mjs",
    "test:mode": "node tests/mode.test.mjs",
    "test:native": "node tests/native-seatbelt.test.mjs",
    "test:backend": "node tests/backend.test.mjs",
    "test:fixes": "node tests/review-fixes.test.mjs",
    "test:pi": "node tests/pi.test.mjs",
    "test:cli": "node tests/cli.test.mjs",
    "test:rpc": "node tests/rpc.test.mjs",
    "test:scale": "node tests/scale.test.mjs"
  }
}
